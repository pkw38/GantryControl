<UserControl x:Class="Gantry_Control.View.Tab.ManualTab.JogTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Gantry_Control.View.Tab.ManualTab"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Indigo" SecondaryColor="Indigo"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <SolidColorBrush x:Key="JogAccentBrush" Color="#002F92"/>

            <Style x:Key="JogIconStyle" TargetType="materialDesign:PackIcon">
                <Setter Property="Width" Value="{Binding ElementName=Cell, Path=ActualHeight, Converter={StaticResource PercentConverter}, ConverterParameter=0.6}"/>
                <Setter Property="Height" Value="{Binding ElementName=Cell, Path=ActualHeight, Converter={StaticResource PercentConverter}, ConverterParameter=0.6}"/>
                <Setter Property="Foreground" Value="{StaticResource JogAccentBrush}"/>
            </Style>

            <Style x:Key="DirectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#94000000"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="{Binding ElementName=Cell, Path=ActualHeight, Converter={StaticResource PercentConverter}, ConverterParameter=0.2}"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Margin" Value="6"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DirectionKey}" Value="right">
                        <Setter Property="VerticalAlignment" Value="Top"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DirectionKey}" Value="backward">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                        <Setter Property="LayoutTransform">
                            <Setter.Value>
                                <RotateTransform Angle="90"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DirectionKey}" Value="forward">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                        <Setter Property="LayoutTransform">
                            <Setter.Value>
                                <RotateTransform Angle="-90"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="JogButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp3"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="0"/>
                <EventSetter Event="MouseEnter" Handler="Button_MouseEnter"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp8"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp24"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="XYJog">
                <TextBlock Text="X/Y JOG"
                           Style="{StaticResource DirectionLabelStyle}"
                           FontSize="{Binding ElementName=XYJog, Path=ActualHeight, Converter={StaticResource PercentConverter}, ConverterParameter=0.3}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1">
                <ItemsControl ItemsSource="{Binding XYMoveButtonList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="Cell">
                                <Button Style="{StaticResource JogButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        PreviewMouseDown="DirectionButton_PressStart"
                                        PreviewMouseUp="DirectionButton_PressEnd"
                                        MouseLeave="DirectionButton_PressEnd"
                                        PreviewTouchDown="DirectionButton_PressStart"
                                        PreviewTouchUp="DirectionButton_PressEnd"
                                        TouchLeave="DirectionButton_PressEnd"
                                        LostMouseCapture="DirectionButton_PressEnd">
                                    <materialDesign:PackIcon Kind="{Binding Icon}" Style="{StaticResource JogIconStyle}"/>
                                </Button>
                                <TextBlock Text="{Binding Direction}"
                                   Visibility="{Binding ShowDirection, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Style="{StaticResource DirectionLabelStyle}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="ZJog">
                <TextBlock Text="Z JOG"
                           Style="{StaticResource DirectionLabelStyle}"
                           FontSize="{Binding ElementName=ZJog, Path=ActualHeight, Converter={StaticResource PercentConverter}, ConverterParameter=0.3}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1">
                <ItemsControl ItemsSource="{Binding ZMoveButtonList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="Cell">
                                <Button Style="{StaticResource JogButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        PreviewMouseDown="DirectionButton_PressStart"
                                        PreviewMouseUp="DirectionButton_PressEnd"
                                        MouseLeave="DirectionButton_PressEnd"
                                        PreviewTouchDown="DirectionButton_PressStart"
                                        PreviewTouchUp="DirectionButton_PressEnd"
                                        TouchLeave="DirectionButton_PressEnd"
                                        LostMouseCapture="DirectionButton_PressEnd">
                                    <materialDesign:PackIcon Kind="{Binding Icon}" Style="{StaticResource JogIconStyle}"/>
                                </Button>
                                <TextBlock Text="{Binding Direction}"
                                           Visibility="{Binding ShowDirection, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Style="{StaticResource DirectionLabelStyle}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="Speed">
                <TextBlock Text="SPEED"
                           Style="{StaticResource DirectionLabelStyle}"
                           FontSize="{Binding ElementName=Speed, Path=ActualHeight, Converter={StaticResource PercentConverter}, ConverterParameter=0.3}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="1" x:Name="SpeedValue">
                <TextBox FontSize="{Binding ElementName=SpeedValue, Path=ActualHeight, Converter={StaticResource PercentConverter}, ConverterParameter=0.3}"
                         Text="{Binding SetSpeed, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="2" x:Name="Home">
                <TextBlock Text="Home"
                           Style="{StaticResource DirectionLabelStyle}"
                           FontSize="{Binding ElementName=Home, Path=ActualHeight, Converter={StaticResource PercentConverter}, ConverterParameter=0.3}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="3" x:Name="HomeValue">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" FontSize="{Binding ElementName=HomeValue, Path=ActualHeight, Converter={StaticResource PercentConverter}, ConverterParameter=0.3}"
                             Text="{Binding SetHome, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="1"></Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
